NODE_ENV=development
PORT=4000
# Public URL people open (QR codes and links). Phone testing over Wi-Fi: http://<your-LAN-IP>:5180
PUBLIC_URL=http://localhost:5180

# ---- Secrets: generate each with  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production refuses to start without them. In development, keys are generated into data/dev-keys.json.
JWT_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Key rotation: set a new ENCRYPTION_KEY + ENCRYPTION_KEY_ID and list old keys here as id:hex,id:hex
ENCRYPTION_KEYS_OLD=
HMAC_KEY=

# First Super Admin (created only when none exists). Two-factor setup is forced at first login.
ADMIN_EMAIL=admin@squaddesk.local
ADMIN_PHONE=+919000000001
ADMIN_PASSWORD=ChangeMe123!

# CAPTCHA - Cloudflare Turnstile. Leave empty to disable. Test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudinary (optional - without it, uploads are stored in server/data/uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=squaddesk

# Demo community data is added on first start in development. Set false to skip.
SEED_DEMO=true

# Proxy hops in front of the app: 1 = host only, 2 = Vercel rewrite in front of Railway/Render.
TRUST_PROXY=1

KEEPALIVE_INTERVAL_MIN=13
KEEPALIVE_URLS=
# KEEPALIVE_ENABLED=false

# ---- n8n automation (optional). See n8n/README.md
# Events (new PDS, status changes, comments, reports, assignment, progress) are POSTed here.
N8N_WEBHOOK_URL=
# Shared secret sent as the X-IntelSquad-Token header; the n8n Webhook node checks it (Header Auth).
N8N_WEBHOOK_SECRET=
# Bearer token n8n uses to call /api/integrations (daily/weekly report, PDS for AI summary, write summary back).
N8N_API_TOKEN=
